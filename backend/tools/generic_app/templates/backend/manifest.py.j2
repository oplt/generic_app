{% if options.frontend %}
from backend.modules.manifests.types import FrontendRoute, ModuleManifest, ModuleSurface, NavEntry
{% else %}
from backend.modules.manifests.types import ModuleManifest, ModuleSurface
{% endif %}

MANIFEST = ModuleManifest(
    key="{{ names.key }}",
    version="1.0.0",
    label="{{ names.label }}",
    description="{{ names.label }} module scaffolded by generic-app create-module.",
    always_enabled={{ always_enabled }},
    optional={{ optional }},
{% if options.frontend %}
    surface=ModuleSurface.USER_FACING,
{% else %}
    surface=ModuleSurface.API_ONLY,
    user_visible=False,
{% endif %}
    dependencies={{ dependencies }},
    backend_router_keys=("{{ names.key }}",),
{% if options.celery %}
    celery_queues=("{{ celery_queue }}",),
{% endif %}
{% if permissions %}
    required_permissions={{ permissions }},
{% endif %}
{% if options.storage %}
    health_checks=("storage",),
{% endif %}
{% if options.crud %}
    database_requirements=("{{ names.table }}",),
{% endif %}
{% if options.frontend %}
    nav_entries=(
        NavEntry(
            label="{{ names.label }}",
            path="{{ nav_path }}",
            group="workspace",
            icon="{{ names.key }}",
{% if permissions %}
            required_permission="{{ names.permission_prefix }}.read",
{% endif %}
        ),
    ),
    frontend_routes=(
        FrontendRoute(
            path="{{ nav_path }}",
            page_key="{{ page_key }}",
{% if permissions %}
            required_permission="{{ names.permission_prefix }}.read",
{% endif %}
        ),
    ),
{% endif %}
)
