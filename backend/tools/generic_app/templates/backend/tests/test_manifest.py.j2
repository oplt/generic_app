from __future__ import annotations

import unittest

from backend.modules.manifests.types import ModuleSurface
from backend.modules.{{ names.key }}.manifest import MANIFEST


class {{ names.pascal }}ManifestTest(unittest.TestCase):
    def test_manifest_key(self) -> None:
        self.assertEqual(MANIFEST.key, "{{ names.key }}")
        self.assertIn("{{ names.key }}", MANIFEST.backend_router_keys)
{% if options.frontend %}
        self.assertEqual(MANIFEST.surface, ModuleSurface.USER_FACING)
        self.assertTrue(MANIFEST.frontend_routes)
