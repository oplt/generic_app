{% else %}
        self.assertEqual(MANIFEST.surface, ModuleSurface.API_ONLY)
        self.assertFalse(MANIFEST.frontend_routes)
{% endif %}
{% if permissions %}
        self.assertIn("{{ names.permission_prefix }}.read", MANIFEST.required_permissions)
{% endif %}
