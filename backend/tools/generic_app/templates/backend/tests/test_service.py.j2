"""Unit tests for {{ names.pascal }}Service ownership mapping."""

from __future__ import annotations

import unittest
from datetime import UTC, datetime
from types import SimpleNamespace
from unittest.mock import AsyncMock, MagicMock

from backend.modules.{{ names.key }}.api.schemas import {{ names.entity_pascal }}Create
from backend.modules.{{ names.key }}.application.service import {{ names.pascal }}Service


class {{ names.pascal }}ServiceTest(unittest.IsolatedAsyncioTestCase):
    async def test_create_maps_response(self) -> None:
        db = AsyncMock()
        db.commit = AsyncMock()
        db.refresh = AsyncMock()
        service = {{ names.pascal }}Service(db)
        created = SimpleNamespace(
            id="item-1",
            user_id="user-1",
            title="Hello",
            description=None,
            created_at=datetime(2026, 1, 1, tzinfo=UTC),
            updated_at=datetime(2026, 1, 1, tzinfo=UTC),
        )
        service.repo = MagicMock()
        service.repo.create = AsyncMock(return_value=created)

        result = await service.create(
            "user-1",
            {{ names.entity_pascal }}Create(title="Hello", description=None),
        )

        self.assertEqual(result.id, "item-1")
        self.assertEqual(result.title, "Hello")
        service.repo.create.assert_awaited_once()
        db.commit.assert_awaited_once()
