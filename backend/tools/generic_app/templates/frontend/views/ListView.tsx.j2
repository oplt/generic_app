import { Skeleton, Stack, Typography } from "@mui/material";

import { PageShell } from "../../../components/ui/PageShell";
import { QueryBoundary } from "../../../components/ui/QueryBoundary";
import { SectionCard } from "../../../components/ui/SectionCard";
import { use{{ names.pascal }}List } from "../hooks/use{{ names.pascal }}List";

export function {{ names.pascal }}ListView() {
    const query = use{{ names.pascal }}List();
    const items = query.data ?? [];

    return (
        <PageShell title="{{ names.label }}">
            <SectionCard
                title="{{ names.label }}"
                description="Scaffolded list view from generic-app create-module."
            >
                <QueryBoundary
                    isLoading={query.isLoading}
                    isError={query.isError}
                    error={query.error}
                    isEmpty={!query.isLoading && items.length === 0}
                    errorFallback="Failed to load {{ names.key }}."
                    onRetry={() => void query.refetch()}
                    loadingFallback={<Skeleton variant="rounded" height={120} />}
                    emptyFallback={
                        <Typography color="text.secondary">No {{ names.key }} yet.</Typography>
                    }
                >
                    <Stack spacing={1.5}>
                        {items.map((item) => (
                            <Typography key={item.id} variant="body1">
                                {item.title}
                            </Typography>
                        ))}
                    </Stack>
                </QueryBoundary>
            </SectionCard>
        </PageShell>
    );
}
